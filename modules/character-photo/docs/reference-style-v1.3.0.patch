diff --git a/test/imagegen-reference-style.test.js b/test/imagegen-reference-style.test.js
new file mode 100644
--- /dev/null
+++ b/test/imagegen-reference-style.test.js
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { createImageGen } from '../src/features/imagegen.js'
+
+const image = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/hT0AAAAASUVORK5CYII=', 'base64')
+
+test('reference style applies only to the current edit and preserves normal drawing defaults', async () => {
+  const imageGen = { enabled: true, provider: 'openai', model: 'fixture', baseUrl: 'https://example.invalid/v1', stylePrompt: '全局水彩' }
+  const prompts = []
+  const service = createImageGen({ getConfig: () => ({ imageGen }), log: { info() {} }, codexAuth: {},
+    fetchImpl: async (url, { body }) => {
+      const edit = body instanceof FormData
+      assert.equal(new URL(url).pathname, edit ? '/v1/images/edits' : '/v1/images/generations')
+      if (edit) assert.equal(body.getAll('image[]').length, 2)
+      prompts.push(edit ? body.get('prompt') : JSON.parse(body).prompt)
+      return Response.json({ data: [{ b64_json: image.toString('base64') }] })
+    } })
+  assert.equal(service.supportsReferenceStyle, true)
+  await service.generate('服饰三视图', { images: [image, image], styleMode: 'reference' })
+  await service.generate('普通绘画')
+  await service.generate('普通编辑', { images: [image, image] })
+  await assert.rejects(service.generate('未选原图', { styleMode: 'reference' }), /参考图/)
+  await assert.rejects(service.generate('拼写错误', { image, styleMode: 'unknown' }), /画风/)
+  assert.deepEqual(prompts, ['服饰三视图', '全局水彩，普通绘画', '全局水彩，普通编辑'])
+  assert.equal(imageGen.stylePrompt, '全局水彩')
+})
